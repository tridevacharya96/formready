    "html-to-pdfmake": "^2.6.0",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pdfmake": "^0.3.14"
  },
  "private": true,
  "type": "module"
}
